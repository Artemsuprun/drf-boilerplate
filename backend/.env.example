#This file is an example file of how the .env.prod file for the backend should be made.

# Required everywhere 
DB_ENGINE=django.db.backends.postgresql
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SIGNING_KEY=Some_JWT_Signing_Key

WEB_CONCURRENCY=2

# Dev
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.X
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Prod
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
# REDIS_URL=redis://redis:6379/0

# Optional
# CSP_REPORT_URI=Some_Report_URI
